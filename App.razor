@inject IWebHostEnvironment Env

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Three stylesheets, in dependency order: theme.css is the token block, app.css the
       component layer that reads it, then the scoped bundle. Nothing in the application links
       a fourth. *@
    <link rel="stylesheet" href="@Assets["css/theme.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["CloudSelfService.styles.css"]" />
    <link rel="icon" type="image/png" href="@Assets["images/advanced-logo-a.png"]" />

    @* Applied before first paint so a dark-mode user never sees a light flash, and so the
       sidebar does not visibly collapse after the circuit connects. Duplicated from
       cloudselfservice.js on purpose - <head> runs long before that file loads. *@
    <script>
        (function () {
            var theme = 'light';
            try {
                var mode = localStorage.getItem('cloudSelfServiceTheme') || 'system';
                theme = mode === 'system'
                    ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                    : (mode === 'dark' ? 'dark' : 'light');
            } catch (e) { /* private mode: fall through to the default above */ }
            document.documentElement.setAttribute('data-bs-theme', theme);

            var collapsed = '0';
            try { collapsed = localStorage.getItem('cloudSelfServiceSidebarCollapsed') || '0'; }
            catch (e) { /* private mode */ }
            document.documentElement.setAttribute('data-sidebar',
                collapsed === '1' ? 'collapsed' : 'expanded');
        })();
    </script>
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>
<body>
    <Routes @rendermode="RenderModeForPage" />

    <div id="blazor-error-ui">
        @if (Env.IsDevelopment())
        {
            <text>An unhandled exception has occurred. See browser dev tools for details.</text>
        }
        else
        {
            <text>An error has occurred. This application may no longer respond until reloaded.</text>
        }
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <ReconnectModal />

    <script src="@Assets["js/cloudselfservice.js"]"></script>
    <script src="@Assets["js/session-guard.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        Blazor.start({
            circuit: {
                configureSignalR: function (builder) {
                    builder.withUrl('/_blazor', { transport: 4 }); // 4 = LongPolling
                },
                reconnectionOptions: {
                    maxRetries: 8,
                    retryIntervalMilliseconds: Array.prototype.at.bind(
                        [0, 2000, 5000, 10000, 15000, 20000, 30000, 45000, 60000])
                }
            }
        }).then(function () {
            window.SessionGuard.initReconnectRecovery();
        });
    </script>
</body>
</html>

@code {
    // Pages marked [ExcludeFromInteractiveRouting] (the error page) render statically so they
    // still work when the circuit is broken.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
