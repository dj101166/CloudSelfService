@inject IWebHostEnvironment Env

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["css/bootstrap/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/site.css"]" />
    <link rel="stylesheet" href="@Assets["CloudSelfService.styles.css"]" />
    <link rel="icon" type="image/png" href="@Assets["images/advanced-logo-a.png"]" />
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>
<body>
    <Routes @rendermode="RenderModeForPage" />

    <div id="blazor-error-ui">
        @if (Env.IsDevelopment())
        {
            <text>An unhandled exception has occurred. See browser dev tools for details.</text>
        }
        else
        {
            <text>An error has occurred. This application may no longer respond until reloaded.</text>
        }
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    @* Custom Blazor SignalR reconnect overlay — see wwwroot/css/site.css for state-class styling. *@
    <div id="components-reconnect-modal" class="reconnect-modal">
        <div class="reconnect-modal-card">
            <div class="reconnect-modal-spinner" aria-hidden="true"></div>
            <p class="reconnect-modal-text reconnect-modal-text--show">Rejoining the server&hellip;</p>
            <p class="reconnect-modal-text reconnect-modal-text--failed">Reconnection failed. Try <a href="" class="reconnect-modal-link">reloading</a> the page.</p>
            <p class="reconnect-modal-text reconnect-modal-text--rejected">Could not reconnect to the server. <a href="" class="reconnect-modal-link">Reload</a> the page to restore functionality.</p>
            <p class="reconnect-modal-text reconnect-modal-text--reloading">Restoring your session&hellip;</p>
        </div>
    </div>

    <script src="@Assets["js/theme-manager.js"]"></script>
    <script src="@Assets["js/session-guard.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        Blazor.start({
            circuit: {
                configureSignalR: function (builder) {
                    builder.withUrl('/_blazor', { transport: 4 }); // 4 = LongPolling
                },
                reconnectionOptions: {
                    maxRetries: 8,
                    retryIntervalMilliseconds: Array.prototype.at.bind(
                        [0, 2000, 5000, 10000, 15000, 20000, 30000, 45000, 60000])
                }
            }
        }).then(function () {
            window.SessionGuard.initReconnectRecovery();
        });
    </script>
</body>
</html>

@code {
    // Pages marked [ExcludeFromInteractiveRouting] (the error page) render statically so they
    // still work when the circuit is broken.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
