<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CloudSelfService</RootNamespace>
    <AssemblyName>CloudSelfService</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CloudSelfService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="CloudSelfService.Docs.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CloudSelfService.Tests\**" />
    <Content Remove="CloudSelfService.Tests\**" />
    <EmbeddedResource Remove="CloudSelfService.Tests\**" />
    <None Remove="CloudSelfService.Tests\**" />
  </ItemGroup>
</Project>
