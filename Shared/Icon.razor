@* One inline-SVG icon, switched on a name. Replaces the Open Iconic webfont: these inherit
   currentColor, so an icon inside a nav link is the nav link's colour in both themes without
   being told twice, and there is no font file to 404.

   Every glyph is 16x16 on a 16-unit grid, stroked rather than filled, so one stroke-width
   and one colour govern the whole set.

   ⚠ No custom property is referenced anywhere in this file, deliberately. An SVG PRESENTATION
   ATTRIBUTE does not resolve one: a fill attribute naming a token draws nothing at all, and
   silently. `currentColor` IS valid as a presentation attribute, which is why the whole set is
   built on it; anything that genuinely needed a token would have to go through a `style`
   attribute, where the declaration is real CSS, rather than through `fill` or `stroke`. *@

<svg class="icon" viewBox="0 0 16 16" width="16" height="16" fill="none"
     stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    @Glyph
</svg>

@code {
    /// <summary>Which glyph to draw. An unrecognised name renders an empty <c>&lt;g&gt;</c>.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    /// <summary>
    /// Every name the switch below handles. Public so a contract test can ask whether a name
    /// resolves WITHOUT rendering the component — an unknown name renders an empty
    /// <c>&lt;g&gt;</c>, which produces no build error, no console message and no visual except
    /// a blank 16px gap, so nothing else in the app would ever report it.
    /// </summary>
    /// <remarks>
    /// Kept in step with the switch by hand. <c>IconNameContractTests</c> reads the switch arms
    /// out of this file's source rather than this set, so the two are independent statements of
    /// the same fact and a drift between them is visible rather than self-confirming.
    /// </remarks>
    public static readonly IReadOnlySet<string> KnownNames = new HashSet<string>(StringComparer.Ordinal)
    {
        "document",
        "folder",
        "file",
        "upload",
        "download",
        "trash",
        "pencil",
        "plus",
        "shield",
        "users",
        "database",
        "history",
        "help",
        "menu",
        "sun",
        "moon",
        "monitor",
        "signout",
        "close",
        "chevron-down",
        "chevron-up",
    };

    /// <summary>Whether <paramref name="name"/> resolves to a glyph.</summary>
    /// <param name="name">The candidate glyph name.</param>
    /// <returns><see langword="true"/> when the switch below has an arm for it.</returns>
    public static bool IsKnownName(string? name) => name is not null && KnownNames.Contains(name);

    private RenderFragment Glyph => this.Name switch
    {
        // ---- Navigation and file-portal glyphs -----------------------------------------

        "document" => @<path d="M3 2.5h6l3.5 3.5v7.5H3z M9 2.5V6h3.5M5.2 8.6h5.2M5.2 11h3.4" />,

        "folder" => @<path d="M1.8 4.4v8.1h12.4V5.6H7.4L6.2 3.9H1.8z" />,

        "file" => @<path d="M3.5 2h5.2l3.8 3.8V14H3.5z M8.5 2v4h4" />,

        "upload" => @<path d="M8 11V2.8M4.8 6 8 2.8 11.2 6M2.6 11.4v2h10.8v-2" />,

        "download" => @<path d="M8 2.8V11M4.8 7.8 8 11l3.2-3.2M2.6 11.4v2h10.8v-2" />,

        "trash" => @<path d="M2.6 4.2h10.8M6.2 4.2V2.6h3.6v1.6M4 4.2l.6 9.2h6.8l.6-9.2M6.6 6.6v4.4M9.4 6.6v4.4" />,

        "pencil" => @<path d="M2.4 13.6l.7-3L10.8 3a1.4 1.4 0 0 1 2 2l-7.7 7.7zM9.6 4.2l2.2 2.2" />,

        "plus" => @<path d="M8 3v10M3 8h10" />,

        "shield" => @<path d="M8 1.8 3 3.6v4.1c0 3 2 5.2 5 6.5 3-1.3 5-3.5 5-6.5V3.6z" />,

        "users" => @<path d="M6 7.4a2.2 2.2 0 1 0 0-4.4 2.2 2.2 0 0 0 0 4.4zM1.8 13.2c0-2.2 1.9-3.6 4.2-3.6s4.2 1.4 4.2 3.6M10.8 3.3a2.2 2.2 0 0 1 0 4.2M11.6 9.8c1.6.3 2.6 1.4 2.6 3.1" />,

        "database" => @<g><ellipse cx="8" cy="4" rx="5" ry="2" /><path d="M3 4v8c0 1.1 2.2 2 5 2s5-.9 5-2V4M3 8c0 1.1 2.2 2 5 2s5-.9 5-2" /></g>,

        "history" => @<path d="M2.4 8a5.6 5.6 0 1 0 1.8-4.1M2.4 2.6v3.2h3.2M8 4.8V8l2.2 1.4" />,

        "help" => @<g><circle cx="8" cy="8" r="6" /><path d="M6.2 6.3a1.9 1.9 0 1 1 2.7 1.7c-.6.3-.9.7-.9 1.4M8 11.4v.2" /></g>,

        // ---- The shell: the rail toggle, the account menu, the dialogs ----------------

        "menu" => @<path d="M2.4 4h11.2M2.4 8h11.2M2.4 12h11.2" />,

        "sun" => @<g><circle cx="8" cy="8" r="3.1" /><path d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M12.8 3.2l-1.1 1.1M4.3 11.7l-1.1 1.1" /></g>,

        "moon" => @<path d="M13 9.5A5.5 5.5 0 0 1 6.5 3a5.5 5.5 0 1 0 6.5 6.5Z" />,

        "monitor" => @<path d="M2.2 3.2h11.6v7.2H2.2zM6 13.2h4M8 10.4v2.8" />,

        "signout" => @<path d="M6.5 13.5H3.5V2.5h3M10 11l3-3-3-3M13 8H6.2" />,

        "close" => @<path d="M3.6 3.6l8.8 8.8M12.4 3.6l-8.8 8.8" />,

        "chevron-down" => @<path d="m4 6.2 4 4 4-4" />,

        "chevron-up" => @<path d="m4 9.8 4-4 4 4" />,

        // A name not in this switch draws nothing and logs nothing. The set is fixed and
        // compiled; a typo should be invisible, not decorative. IconNameContractTests is the
        // only thing that can see one.
        _ => @<g></g>
    };
}
