@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ILogger<UploadPanel> Logger
@using CloudSelfService.Services.Access
@using CloudSelfService.Services.Files
@using CloudSelfService.Services.Transfers

@*
    The upload queue for the file browser. The bytes go from the browser straight to /api/uploads through
    wwwroot/js/uploader.js; this component only shows what that script reports. The page owns the file input and
    calls StartAsync when files are chosen or dropped.

    Leaving the Files pages stops the uploads (the server keeps each one for 24 hours after its last piece arrived,
    and at most 7 days, so choosing the same file again resumes), which is why a navigation away with uploads running
    asks first. The same holds when the sign-in ends: running uploads pause, and after signing in again the page lists
    this folder's unfinished uploads as rows waiting for their file. Their "Select file" is prerendered disabled and
    enabled once the circuit is live, so a file chosen before then is not lost.
*@
<NavigationLock ConfirmExternalNavigation="this.HasActive" OnBeforeInternalNavigation="this.OnBeforeNavigationAsync" />

@{ var waiting = UploadItem.WaitingRows(this.Unfinished, this._items, this._claimed); }
@if (this._items.Count > 0 || waiting.Count > 0)
{
    <section class="card upload-panel" data-testid="upload-panel" aria-label="Uploads">
        <div class="upload-panel__head">
            <div class="upload-panel__heading">
                <h2 class="card__title upload-panel__title">Uploads</h2>
                @if (this.LimitBytes is { } limit)
                {
                    <span class="upload-panel__limit u-small" data-testid="upload-limit-text">@LimitText(limit)</span>
                }
            </div>
            @if (this._items.Any(i => i.IsFinished))
            {
                <button type="button" class="btn btn--link btn--sm" data-testid="upload-clear" @onclick="this.ClearFinishedAsync">
                    Clear finished
                </button>
            }
        </div>
        @if (this._sessionEndsAt is { } endsAt && this.HasActive)
        {
            <div class="alert alert--warning upload-panel__banner" role="status" data-testid="upload-session-ending">
                @UploadStatusNames.SessionEndingText(endsAt, this.Zone)
            </div>
        }
        <ul class="upload-panel__list">
            @foreach (var item in this._items)
            {
                <li class="upload-panel__item" data-testid="upload-item" data-status="@item.Status" @key="item.Id">
                    <div class="upload-panel__row">
                        <Icon Name="file" />
                        <span class="upload-panel__name" title="@StoragePath.DisplayName(item.Name)">@StoragePath.DisplayName(item.Name)</span>
                        <span class="upload-panel__size u-subtle">@FileDisplay.Size(item.Sent) of @FileDisplay.Size(item.Size)</span>
                        <span class="upload-panel__actions">
                            @if (item.IsActive)
                            {
                                <button type="button" class="btn btn--secondary btn--sm" data-testid="upload-pause"
                                        @onclick="() => this.PauseAsync(item)">Pause</button>
                            }
                            @if (item.CanResume)
                            {
                                <button type="button" class="btn btn--secondary btn--sm" data-testid="upload-resume"
                                        @onclick="() => this.ResumeAsync(item)">Resume</button>
                            }
                            @if (item.Status == UploadStatusNames.Conflict)
                            {
                                <button type="button" class="btn btn--secondary btn--sm" data-testid="upload-replace"
                                        @onclick="() => this.AskOverwrite(item)">Replace…</button>
                            }
                            @if (!item.IsFinished)
                            {
                                <button type="button" class="btn btn--icon btn--sm" data-testid="upload-cancel"
                                        aria-label="Cancel upload of @StoragePath.DisplayName(item.Name)" title="Cancel"
                                        @onclick="() => this.CancelAsync(item)">
                                    <Icon Name="close" />
                                </button>
                            }
                        </span>
                    </div>
                    <div class="upload-panel__track" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                         aria-valuenow="@item.Percent" aria-label="@StoragePath.DisplayName(item.Name)">
                        <div class="upload-panel__fill @FillModifier(item)" style="width: @(item.Percent)%"></div>
                    </div>
                    <p class="upload-panel__status @StatusModifier(item)" data-testid="upload-status">
                        @UploadStatusNames.Label(item)
                        @if (item.Status == UploadStatusNames.SignedOut)
                        {
                            <a href="/login" class="upload-panel__sign-in" data-testid="upload-sign-in">Sign in again</a>
                        }
                    </p>
                    @if (item.Notice is { Length: > 0 } notice)
                    {
                        <p class="upload-panel__notice" data-testid="upload-notice">@notice</p>
                    }
                </li>
            }
            @foreach (var u in waiting)
            {
                var row = UploadItem.Waiting(u);
                var inputId = ResumeInputId(u);
                <li class="upload-panel__item" data-testid="upload-item" data-status="@row.Status" data-session-id="@u.SessionId" @key="row.Id">
                    <div class="upload-panel__row">
                        <Icon Name="file" />
                        <span class="upload-panel__name" title="@StoragePath.DisplayName(row.Name)">@StoragePath.DisplayName(row.Name)</span>
                        <span class="upload-panel__size u-subtle">@FileDisplay.Size(row.Sent) of @FileDisplay.Size(row.Size)</span>
                        <span class="upload-panel__actions">
                            <input type="file" id="@inputId" class="upload-panel__file-input" data-testid="upload-select-input"
                                   aria-label="Select @StoragePath.DisplayName(row.Name) again to carry on uploading it"
                                   disabled="@(!this._ready)" @onchange="() => this.SelectFileAsync(u, inputId)" />
                            <label for="@inputId" class="btn btn--secondary btn--sm" data-testid="upload-select-file"
                                   aria-disabled="@(this._ready ? null : "true")">Select file</label>
                        </span>
                    </div>
                    <div class="upload-panel__track" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                         aria-valuenow="@row.Percent" aria-label="@StoragePath.DisplayName(row.Name)">
                        <div class="upload-panel__fill @FillModifier(row)" style="width: @(row.Percent)%"></div>
                    </div>
                    <p class="upload-panel__status @StatusModifier(row)" data-testid="upload-status">@UploadStatusNames.Label(row)</p>
                </li>
            }
        </ul>
    </section>
}
else if (this.LimitBytes is { } limit)
{
    <p class="upload-panel__limit upload-panel__limit--alone u-small" data-testid="upload-limit-text">@LimitText(limit)</p>
}

<ConfirmDialog IsOpen="this._conflict is not null"
               Title="Replace file?"
               Message="@($"{StoragePath.DisplayName(this._conflict?.Name ?? "")} already exists. Replace it?")"
               ConfirmText="Replace"
               Danger="true"
               OnConfirm="this.ConfirmOverwriteAsync"
               OnCancel="this.SkipOverwriteAsync" />

@code {
    public const string SkippedMessage = "Not uploaded: a file with that name already exists.";
    public const string LeaveWarning = "Uploads are still running. Leaving this page stops them; select the same files again later to carry on. Leave anyway?";

    /// <summary>Raised when a file finishes uploading, so the page can refresh the folder it landed in.</summary>
    [Parameter] public EventCallback<UploadItem> OnUploaded { get; set; }

    /// <summary>Raised when a call into uploader.js fails, so the page can say the upload component is broken.</summary>
    [Parameter] public EventCallback OnScriptFailed { get; set; }

    /// <summary>Raised when the server refuses an upload as not allowed, so the page can re-read the access level.</summary>
    [Parameter] public EventCallback OnAccessDenied { get; set; }

    /// <summary>This folder's unfinished uploads on the server, each shown waiting for its file unless already in the panel.</summary>
    [Parameter] public IReadOnlyList<UnfinishedUpload> Unfinished { get; set; } = Array.Empty<UnfinishedUpload>();

    /// <summary>The largest file the caller may upload, or null to say nothing (no upload access, or not known).</summary>
    [Parameter] public long? LimitBytes { get; set; }

    /// <summary>The viewer's time zone, for the sign-in-ending warning; UTC (labelled) while unknown.</summary>
    [Parameter] public TimeZoneInfo? Zone { get; set; }

    private readonly List<UploadItem> _items = new();
    private readonly Queue<UploadItem> _conflicts = new();
    private UploadItem? _conflict;
    private DotNetObjectReference<UploadPanel>? _ref;
    private readonly string _owner = Guid.NewGuid().ToString("N");
    private readonly HashSet<Guid> _claimed = new();
    private readonly EarlyUploadUpdates _early = new();
    private DateTimeOffset? _sessionEndsAt;
    private bool _ready;

    private bool HasActive => this._items.Any(i => i.IsActive);

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        this._ready = true;
        this.StateHasChanged();
    }

    /// <summary>Hands the files chosen in <paramref name="inputElementId"/> to uploader.js.</summary>
    public Task StartAsync(Guid targetId, string folder, string inputElementId) =>
        this.StartAsync(targetId, folder, inputElementId, null);

    /// <summary>
    /// Starts the file chosen for a row waiting for its file. The session's own overwrite choice goes with it, so a
    /// replace the user already confirmed is not asked again (Begin still re-checks the user may overwrite), but only
    /// for a file of that name.
    /// </summary>
    private async Task StartAsync(Guid targetId, string folder, string inputElementId, UnfinishedUpload? resuming)
    {
        this._ref ??= DotNetObjectReference.Create(this);
        var started = await this.JS.InvokeAsync<UploadStart[]>("csspUploader.start", this._ref, targetId.ToString(), folder,
            inputElementId, resuming?.Overwrite ?? false, this._owner, CloudSelfService.Endpoints.UploadEndpoints.AntiforgeryMessage,
            resuming?.FileName);
        foreach (var s in started ?? Array.Empty<UploadStart>())
        {
            var item = this._items.FirstOrDefault(i => i.Id == s.Id);
            if (item is null)
            {
                item = new UploadItem(s.Id, s.Name, targetId, folder, s.Size);
                this._items.Add(item);
            }
            else
            {
                item.Message = null;
            }
            item.Notice = null;
            item.ResumingSessionId = resuming?.SessionId;
            this._early.ApplyTo(item);
            // Begin resumes or replaces the server session a started file matches, so its waiting row must not come
            // back when the finished item is cleared from the panel.
            foreach (var u in this.Unfinished.Where(item.IsFor))
                this._claimed.Add(u.SessionId);
        }
        if (resuming is not null && started is { Length: > 0 })
            this._claimed.Add(resuming.SessionId);
        this.StateHasChanged();
    }

    private async Task SelectFileAsync(UnfinishedUpload u, string inputId)
    {
        try
        {
            await this.StartAsync(u.TargetId, u.Folder, inputId, u);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException)
        {
            this.Logger.LogWarning(ex, "Starting the upload for unfinished session {SessionId} failed.", u.SessionId);
            await this.OnScriptFailed.InvokeAsync();
        }
    }

    /// <summary>Begin answered with a session; one other than the row's means the server started the file afresh.</summary>
    [JSInvokable]
    public Task OnSession(string id, string sessionId) => this.UpdateAsync(id, item =>
    {
        if (item.ResumingSessionId is not { } resuming) return;
        item.ResumingSessionId = null;
        if (Guid.TryParse(sessionId, out var begun) && begun == resuming) return;
        item.Notice = UploadStatusNames.DifferentFileMessage;
        // Begin replaces every open session for the same name, so only a file under another name leaves the row's
        // session on the server, and only then does its row come back.
        if (this.Unfinished.FirstOrDefault(u => u.SessionId == resuming) is { } row
            && !string.Equals(item.Name, row.FileName, StringComparison.Ordinal))
            this._claimed.Remove(resuming);
    });

    [JSInvokable]
    public Task OnSessionEnding(string id, string endsAtIso)
    {
        if (this._sessionEndsAt is not null
            || !DateTimeOffset.TryParse(endsAtIso, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.RoundtripKind, out var endsAt))
            return Task.CompletedTask;
        this._sessionEndsAt = endsAt;
        return this.InvokeAsync(this.StateHasChanged);
    }

    [JSInvokable]
    public Task OnProgress(string id, string fileName, long sent, long total) => this.UpdateAsync(id, item =>
    {
        item.Sent = sent;
        item.Size = total;
    });

    [JSInvokable]
    public Task OnStatus(string id, string status, string? message) => this.UpdateAsync(id, item =>
    {
        item.Status = status;
        item.Message = message;
    });

    [JSInvokable]
    public async Task OnFileDone(string id, string fileName, bool ok, string? message)
    {
        var item = this.Find(id);
        if (item is null) return;
        item.Status = ok ? UploadStatusNames.Done : UploadStatusNames.Failed;
        item.Message = message;
        if (ok) item.Sent = item.Size;
        await this.InvokeAsync(this.StateHasChanged);
        if (ok) await this.OnUploaded.InvokeAsync(item);
    }

    [JSInvokable]
    public Task OnConflict(string id, string fileName)
    {
        var item = this.Find(id);
        if (item is null) return Task.CompletedTask;
        item.Status = UploadStatusNames.Conflict;
        this.AskOverwrite(item);
        return this.InvokeAsync(this.StateHasChanged);
    }

    [JSInvokable]
    public Task OnDenied(string id) => this.OnAccessDenied.InvokeAsync();

    private UploadItem? Find(string id) => this._items.FirstOrDefault(i => i.Id == id);

    private Task UpdateAsync(string id, Action<UploadItem> change)
    {
        var item = this.Find(id);
        if (item is null)
        {
            this._early.Hold(id, change);
            return Task.CompletedTask;
        }
        change(item);
        return this.InvokeAsync(this.StateHasChanged);
    }

    private void AskOverwrite(UploadItem item)
    {
        if (this._conflict is null) this._conflict = item;
        else if (this._conflict != item && !this._conflicts.Contains(item)) this._conflicts.Enqueue(item);
    }

    private void NextConflict() =>
        this._conflict = this._conflicts.Count > 0 ? this._conflicts.Dequeue() : null;

    private async Task ConfirmOverwriteAsync()
    {
        var item = this._conflict;
        this.NextConflict();
        if (item is null) return;
        item.Message = null;
        await this.CallAsync("csspUploader.overwrite", item.Id);
    }

    private async Task SkipOverwriteAsync()
    {
        var item = this._conflict;
        this.NextConflict();
        if (item is null) return;
        item.Status = UploadStatusNames.Failed;
        item.Message = SkippedMessage;
        await this.CallAsync("csspUploader.forget", item.Id);
    }

    private Task PauseAsync(UploadItem item) => this.CallAsync("csspUploader.pause", item.Id);

    private Task ResumeAsync(UploadItem item) => this.CallAsync("csspUploader.resume", item.Id);

    private async Task CancelAsync(UploadItem item)
    {
        this._items.Remove(item);
        if (this._conflict == item) this.NextConflict();
        await this.CallAsync("csspUploader.cancel", item.Id);
    }

    private async Task ClearFinishedAsync()
    {
        foreach (var item in this._items.Where(i => i.IsFinished).ToList())
        {
            this._items.Remove(item);
            await this.CallAsync("csspUploader.forget", item.Id);
        }
    }

    private async Task CallAsync(string identifier, string id)
    {
        try
        {
            await this.JS.InvokeVoidAsync(identifier, id);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException)
        {
            this.Logger.LogWarning(ex, "Upload script call {Identifier} failed.", identifier);
            await this.OnScriptFailed.InvokeAsync();
        }
    }

    private async Task OnBeforeNavigationAsync(LocationChangingContext context)
    {
        if (!this.HasActive) return;
        var relative = this.Nav.ToBaseRelativePath(context.TargetLocation);
        if (relative.StartsWith("files/", StringComparison.OrdinalIgnoreCase)) return;
        try
        {
            if (!await this.JS.InvokeAsync<bool>("confirm", LeaveWarning))
                context.PreventNavigation();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException)
        {
            this.Logger.LogWarning(ex, "The leave-page confirmation failed; navigating anyway.");
        }
    }

    private static string FillModifier(UploadItem item) => item.Status switch
    {
        UploadStatusNames.Done => "upload-panel__fill--done",
        UploadStatusNames.Failed or UploadStatusNames.Conflict => "upload-panel__fill--failed",
        UploadStatusNames.Paused or UploadStatusNames.Interrupted or UploadStatusNames.Waiting or UploadStatusNames.SignedOut
            or UploadStatusNames.WaitingForFile => "upload-panel__fill--held",
        _ => "",
    };

    private static string StatusModifier(UploadItem item) => item.Status switch
    {
        UploadStatusNames.Done => "upload-panel__status--done",
        UploadStatusNames.Failed or UploadStatusNames.Conflict => "upload-panel__status--failed",
        UploadStatusNames.Interrupted or UploadStatusNames.Waiting or UploadStatusNames.SignedOut => "upload-panel__status--held",
        _ => "",
    };

    private static string LimitText(long bytes) => $"Files up to {UploadLimitService.FormatGb(bytes)} GB";

    private static string ResumeInputId(UnfinishedUpload u) => "upload-resume-" + u.SessionId.ToString("N");

    public async ValueTask DisposeAsync()
    {
        if (this._ref is null) return;
        try
        {
            await this.JS.InvokeVoidAsync("csspUploader.detach", this._owner);
        }
        catch (JSDisconnectedException)
        {
        }
        this._ref.Dispose();
    }
}
