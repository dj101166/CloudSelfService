@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject CloudSelfService.Services.AppVersionService VersionService

<PageTitle>Advanced Cloud Self Service</PageTitle>

<div class="app">
    <header class="app__header">
        <button class="app__rail-toggle" @onclick="this.ToggleSidebarAsync"
                title="Toggle navigation" aria-label="Toggle navigation">
            <Icon Name="menu" />
        </button>

        @* The logo is decorative and carries an empty alt deliberately: the wordmark beside it
           is the accessible name, and a screen reader announcing "Advanced logo CLOUD SELF
           SERVICE" would say the brand twice. *@
        <a class="app__brand" href="">
            <img class="app__logo" src="images/advanced-logo-a.png" alt="" />
            <span class="app__brand__text">Cloud Self Service</span>
        </a>

        <button class="app__version" data-testid="app-version"
                @onclick="this.ToggleChangelog" title="View release notes">
            @* Parenthesised deliberately: Razor reads a bare `v@x` as an email address and
               emits it as literal text, so the chip would read "v@VersionService" forever. *@
            v@(this.VersionService.Version)
        </button>

        <div class="app__header-spacer"></div>

        <AppMenu OnShowChangelog="this.OpenChangelog" />
    </header>

    <div class="app__body">
        <aside class="app__sidebar @(this._drawerOpen ? "is-open" : "")">
            <NavMenu />
        </aside>

        @if (this._drawerOpen)
        {
            <div class="app__scrim" @onclick="this.CloseDrawer"></div>
        }

        <main class="app__main">
            <div class="app__main-inner">
                @this.Body
            </div>
        </main>
    </div>
</div>

<ChangelogDialog IsOpen="this._changelogOpen" OnClose="this.CloseChangelog" />

@code {
    private bool _changelogOpen;

    /// <summary>
    /// Only meaningful below the 860px breakpoint, where the sidebar is a drawer. Above it the
    /// sidebar is always in the flow and this class changes nothing.
    /// </summary>
    private bool _drawerOpen;

    private async Task ToggleSidebarAsync()
    {
        // Two behaviours behind one button, because they are the same intent at two widths: on a
        // wide screen it collapses the column to a rail (and persists that), on a narrow one it
        // opens the drawer (and does not). The branch is what keeps them exclusive — without it,
        // opening and closing the drawer on a phone would silently flip the persisted rail state
        // a wide screen reads later.
        if (await this.JSRuntime.InvokeAsync<bool>("cssp.isCompact"))
        {
            this._drawerOpen = !this._drawerOpen;
        }
        else
        {
            var collapsed = await this.JSRuntime.InvokeAsync<bool>("cssp.getSidebarCollapsed");
            await this.JSRuntime.InvokeVoidAsync("cssp.setSidebarCollapsed", !collapsed);
        }
    }

    private void CloseDrawer() => this._drawerOpen = false;

    private void ToggleChangelog() => this._changelogOpen = !this._changelogOpen;

    private void OpenChangelog() => this._changelogOpen = true;

    private void CloseChangelog() => this._changelogOpen = false;
}
