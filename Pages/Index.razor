@page "/"
@attribute [Authorize]
@inject StorageAccessService Access
@inject CurrentUser CurrentUser
@inject UploadSessionService Uploads
@inject PageAuditContext Audit
@inject IJSRuntime JS
@inject ILogger<Index> Logger
@using CloudSelfService.Models
@using CloudSelfService.Services.Access
@using CloudSelfService.Services.Files
@using CloudSelfService.Services.Identity
@using CloudSelfService.Services.Transfers

@*
    Files home: every share and container this user can reach. Customers see their own as a flat set of cards; staff
    see every customer's, grouped by customer, with targets that belong to no customer under "Advanced internal".
    Above them, the user's own unfinished uploads (if any), so an upload cut short by a sign-out can be found again.
*@

<PageTitle>Files — Advanced Cloud Self Service</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title">Files</h1>
        <p class="page-subtitle">@this.Subtitle</p>
    </div>
    @if (this._isStaff && this._targets.Count > 0)
    {
        <div class="page-head__filters">
            <label class="u-sr-only" for="target-filter">Filter by customer or storage name</label>
            <input id="target-filter" class="input home__filter" type="search" placeholder="Filter by customer or name"
                   autocomplete="off" data-testid="target-filter" @bind="this._filter" @bind:event="oninput" />
        </div>
    }
</div>

@if (this._error is not null)
{
    <div class="alert alert--warning" role="alert" data-testid="alert">@this._error</div>
}
else if (!this._loaded)
{
    <div class="loading"><span class="spinner spinner--lg"></span> Loading…</div>
}
else if (this._targets.Count == 0)
{
    <div class="card home__empty" data-testid="home-empty">
        <Icon Name="folder" />
        <p>@EmptyMessage</p>
    </div>
}
else
{
    @if (this._discardFailed)
    {
        <div class="alert alert--warning" role="alert" data-testid="alert">@UnavailableMessage</div>
    }
    @if (this._unfinished.Count > 0)
    {
        <section class="card home__unfinished" aria-labelledby="unfinished-title" data-testid="unfinished-uploads">
            <div class="card__head">
                <h2 class="card__title" id="unfinished-title">Unfinished uploads</h2>
                <p class="card__desc">Choose the same file again in its folder to carry on where it stopped.</p>
            </div>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">File</th>
                            <th scope="col">Progress</th>
                            <th scope="col">Last activity</th>
                            <th scope="col"><span class="u-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in this._unfinished)
                        {
                            <tr data-testid="unfinished-upload" data-session-id="@u.SessionId" @key="u.SessionId">
                                <td>
                                    <div class="home__unfinished-name">@StoragePath.DisplayName(u.FileName)</div>
                                    <div class="u-subtle u-small">@LocationText(u)</div>
                                </td>
                                <td class="u-nowrap">@ReceivedText(u)</td>
                                <td>
                                    <div class="u-nowrap">@FileDisplay.Modified(u.LastActivity, this._zone)</div>
                                    <div class="u-subtle u-small u-nowrap">Discarded after @FileDisplay.Modified(u.ExpiresAt, this._zone)</div>
                                </td>
                                <td class="table__num">
                                    <span class="u-row home__unfinished-actions">
                                        <a class="btn btn--secondary btn--sm" href="@FileDisplay.BrowseHref(u.TargetId, u.Folder)"
                                           data-testid="unfinished-open">Open folder</a>
                                        <button type="button" class="btn btn--danger btn--sm" data-testid="unfinished-discard"
                                                disabled="@this._busy" @onclick="() => this.AskDiscard(u)">Discard</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    var groups = this.Groups().ToList();
    @if (groups.Count == 0)
    {
        <p class="u-muted" data-testid="home-no-match">Nothing matches “@this._filter”.</p>
    }
    @foreach (var group in groups)
    {
        <section class="home__group" data-testid="target-group">
            @if (this._isStaff)
            {
                <h2 class="home__group-title">@group.Heading</h2>
            }
            <div class="card-grid">
                @foreach (var r in group.Targets)
                {
                    <a class="card home__card" href="@FileDisplay.BrowseHref(r.Target.Id, "")" data-testid="target-card"
                       data-target-id="@r.Target.Id" data-target-name="@StoragePath.DisplayName(r.Target.DisplayName)">
                        <span class="home__card-icon"><Icon Name="@(r.Target.Kind == StorageKind.FileShare ? "folder" : "database")" /></span>
                        <span class="home__card-body">
                            <span class="home__card-name">@StoragePath.DisplayName(r.Target.DisplayName)</span>
                            <span class="u-row u-row--wrap home__card-badges">
                                <span class="badge badge--muted">@(r.Target.Kind == StorageKind.FileShare ? "File share" : "Blob container")</span>
                                <span class="badge @LevelBadge(r.Level)">@r.Level</span>
                            </span>
                        </span>
                    </a>
                }
            </div>
        </section>
    }
}

<ConfirmDialog IsOpen="this._discarding is not null"
               Title="Discard upload"
               Message="@this.DiscardMessage"
               ConfirmText="Discard"
               Danger="true"
               Busy="this._busy"
               OnConfirm="this.ConfirmDiscardAsync"
               OnCancel="this.CloseDiscard" />

@code {
    public const string EmptyMessage =
        "No storage has been shared with you yet. Contact Advanced support if you expected to see something here.";
    public const string InternalHeading = "Advanced internal";
    public const string UnavailableMessage = "The service is temporarily unavailable.";

    private IReadOnlyList<ReachableTarget> _targets = Array.Empty<ReachableTarget>();
    private bool _isStaff;
    private bool _loaded;
    private string? _error;
    private string _filter = "";
    private IReadOnlyList<UnfinishedUpload> _unfinished = Array.Empty<UnfinishedUpload>();
    private UnfinishedUpload? _discarding;
    private bool _busy;
    private bool _discardFailed;
    private TimeZoneInfo? _zone;
    private Guid _userId;

    private sealed record Group(string Heading, IReadOnlyList<ReachableTarget> Targets);

    private string Subtitle => this._isStaff
        ? "Every customer's shares and containers. Choose one to browse it."
        : "The shares and containers Advanced hosts for you. Choose one to browse it.";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await this.CurrentUser.GetAsync();
            if (user is null)
            {
                this._error = UnavailableMessage;
                return;
            }
            this._isStaff = user.Kind == UserKind.Staff;
            this._userId = user.Id;
            this._targets = await this.Access.ListReachableTargetsAsync(user.Id);
            this._loaded = true;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            this.Logger.LogError(ex, "Listing reachable targets failed.");
            this._error = UnavailableMessage;
            return;
        }
        await this.LoadUnfinishedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var tz = await this.JS.InvokeAsync<BrowserTimeZone>("cssp.timeZone");
            this._zone = FileDisplay.ResolveZone(tz.Id, tz.Offset);
            this.StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException ex)
        {
            this.Logger.LogDebug(ex, "Could not read the browser time zone; showing UTC.");
        }
    }

    /// <summary>
    /// The card is secondary to the target list: a failure here is logged and the card left out, so the page's
    /// unavailable message never hides storage the user can still reach.
    /// </summary>
    private async Task LoadUnfinishedAsync()
    {
        try
        {
            this._unfinished = await this.Uploads.ListUnfinishedAsync(this._userId);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            this.Logger.LogError(ex, "Listing unfinished uploads failed.");
            this._unfinished = Array.Empty<UnfinishedUpload>();
        }
    }

    private string DiscardMessage => this._discarding is null
        ? ""
        : $"Discard the unfinished upload of {StoragePath.DisplayName(this._discarding.FileName)}? What was sent so far is deleted.";

    private static string LocationText(UnfinishedUpload u) =>
        u.Folder.Length == 0
            ? StoragePath.DisplayName(u.TargetName)
            : $"{StoragePath.DisplayName(u.TargetName)} / {StoragePath.DisplayName(u.Folder)}";

    private static string ReceivedText(UnfinishedUpload u) =>
        $"{(u.Size == 0 ? 0 : u.ReceivedBytes * 100 / u.Size)}% received";

    private void AskDiscard(UnfinishedUpload u)
    {
        if (this._busy) return;
        this._discarding = u;
    }

    private void CloseDiscard()
    {
        if (this._busy) return;
        this._discarding = null;
    }

    private async Task ConfirmDiscardAsync()
    {
        if (this._busy || this._discarding is not { } u) return;
        this._busy = true;
        this._discardFailed = false;
        try
        {
            // NotFound or Denied mean the upload is already gone or no longer the user's to finish; the reload hides it.
            var result = await this.Uploads.AbortAsync(this._userId, u.SessionId, this.Audit.Next());
            this._discardFailed = result.Outcome is not (AccessOutcome.Ok or AccessOutcome.NotFound or AccessOutcome.Denied);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            this.Logger.LogError(ex, "Discarding unfinished upload {SessionId} failed.", u.SessionId);
            this._discardFailed = true;
        }
        finally
        {
            this._busy = false;
            this._discarding = null;
        }
        await this.LoadUnfinishedAsync();
    }

    private IEnumerable<Group> Groups()
    {
        var filter = this._filter.Trim();
        var visible = filter.Length == 0
            ? this._targets
            : this._targets.Where(r => Matches(r.Target.DisplayName, filter) || Matches(r.Customer?.Name, filter)
                                       || (r.Customer is null && Matches(InternalHeading, filter)));
        if (!this._isStaff)
        {
            var all = visible.ToList();
            if (all.Count > 0) yield return new Group("", all);
            yield break;
        }

        // Customers alphabetically, then the internal group last.
        foreach (var g in visible.Where(r => r.Customer is not null)
                     .GroupBy(r => r.Customer!.Id)
                     .OrderBy(g => g.First().Customer!.Name, StringComparer.OrdinalIgnoreCase))
            yield return new Group(StoragePath.DisplayName(g.First().Customer!.Name), g.ToList());
        var internalTargets = visible.Where(r => r.Customer is null).ToList();
        if (internalTargets.Count > 0) yield return new Group(InternalHeading, internalTargets);
    }

    private static bool Matches(string? text, string filter) =>
        text is not null && text.Contains(filter, StringComparison.OrdinalIgnoreCase);

    private static string LevelBadge(AccessLevel level) => level switch
    {
        AccessLevel.Full => "badge--accent",
        AccessLevel.Contribute => "badge--info",
        _ => "badge--muted",
    };
}
